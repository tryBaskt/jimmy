{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BootstrapAndInspectDevStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPolicy",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::jimmy-dev-terraform-state-499133675835"
    },
    {
      "Sid": "ReadWriteDevState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/terraform.tfstate",
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/backend/terraform.tfstate",
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/frontend/terraform.tfstate"
      ]
    },
    {
      "Sid": "ManageDevStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/terraform.tfstate.tflock",
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/backend/terraform.tfstate.tflock",
        "arn:aws:s3:::jimmy-dev-terraform-state-499133675835/dev/frontend/terraform.tfstate.tflock"
      ]
    }
  ]
}
