{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProvisionStockTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:499133675835:table/jimmy-dev-stock-metadata",
        "arn:aws:dynamodb:us-east-1:499133675835:table/jimmy-dev-stock-universe-membership",
        "arn:aws:dynamodb:us-east-1:499133675835:table/jimmy-dev-user-sessions",
        "arn:aws:dynamodb:us-east-1:499133675835:table/jimmy-dev-strategy-jobs"
      ]
    }
  ]
}
